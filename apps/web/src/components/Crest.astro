---
/*
  The crest: the way out is always visible. Pass navigation links as children;
  give the main action the `button` class.
*/
interface Props {
  name?: string;
}
const { name = 'Threshold' } = Astro.props;
---

<header class="crest">
  <a class="mark" href="/">
    <svg viewBox="0 0 32 32" aria-hidden="true">
      <circle cx="16" cy="16" r="12" fill="none" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.5"></circle>
      <circle cx="19.5" cy="12.5" r="4" fill="var(--accent)"></circle>
    </svg>
    <span>{name}</span>
  </a>
  <nav aria-label="Main">
    <slot />
  </nav>
</header>

<style>
  .crest {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem var(--gutter);
    background: linear-gradient(to bottom, color-mix(in srgb, var(--bg) 92%, transparent) 35%, transparent);
  }

  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
    font-size: 1.3rem;
    font-weight: 500;
    text-decoration: none;
  }
  .mark svg {
    width: 1.6rem;
    height: 1.6rem;
    flex: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 2.5vw, 1.75rem);
    font-family: var(--font-guide);
    font-size: 1rem;
  }
  nav :global(a:not(.button)) {
    color: var(--ink-soft);
    text-decoration: none;
  }
  nav :global(a:not(.button):hover) {
    color: var(--ink-lit);
  }

  @media (max-width: 34rem) {
    .mark span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    nav :global(.button) {
      padding: 0.5em 0.95em;
    }
  }
</style>
